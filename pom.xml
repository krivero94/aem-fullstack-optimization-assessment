<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.assessment</groupId>
    <artifactId>aem-fullstack-optimization-assessment</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>AEM Full-Stack Optimization Assessment</name>

    <modules>
        <module>core</module>
        <module>ui.apps.structure</module>
        <module>ui.apps</module>
        <module>ui.config</module>
        <module>ui.content</module>
        <module>ui.frontend</module>
        <module>it.tests</module>
        <module>ui.tests</module>
        <module>all</module>
        <module>dispatcher</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <aem.sdk.api.version>2026.2.24464.20260214T050318Z-260100</aem.sdk.api.version>
        <sling.models.version>1.5.0</sling.models.version>
        <osgi.annotations.version>1.4.0</osgi.annotations.version>
        <maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
        <maven.bundle.plugin.version>5.1.9</maven.bundle.plugin.version>
        <filevault.package.plugin.version>1.3.6</filevault.package.plugin.version>
        <sling.maven.plugin.version>2.4.2</sling.maven.plugin.version>

        <aem.host>localhost</aem.host>
        <aem.port>4502</aem.port>
        <sling.user>admin</sling.user>
        <sling.password>admin</sling.password>
        <vault.user>admin</vault.user>
        <vault.password>admin</vault.password>
        <frontend-maven-plugin.version>1.12.0</frontend-maven-plugin.version>
        <core.wcm.components.version>2.26.0</core.wcm.components.version>
        <bnd.version>5.1.2</bnd.version>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <buildNumber>${maven.build.timestamp}</buildNumber>
        <maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
    </properties>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>adobe-public</id>
            <url>https://repo.adobe.com/nexus/content/groups/public/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </pluginRepository>
        <pluginRepository>
            <id>adobe-public</id>
            <url>https://repo.adobe.com/nexus/content/groups/public/</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.jackrabbit</groupId>
                    <artifactId>filevault-package-maven-plugin</artifactId>
                    <version>1.3.6</version>
                    <extensions>true</extensions>
                </plugin>
                <plugin>
                    <groupId>io.wcm.maven.plugins</groupId>
                    <artifactId>wcmio-content-package-maven-plugin</artifactId>
                    <version>2.1.2</version>
                    <configuration>
                        <serviceURL>http://${aem.host}:${aem.port}/crx/packmgr/service.jsp</serviceURL>
                        <userId>${vault.user}</userId>
                        <password>${vault.password}</password>
                        <bundleStatusWait>false</bundleStatusWait>
                        <relaxedSSLCheck>true</relaxedSSLCheck>
                        <retryCount>5</retryCount>
                        <retryDelaySeconds>10</retryDelaySeconds>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>autoInstallPackage</id>
            <build>

            </build>
        </profile>

    </profiles>
</project>