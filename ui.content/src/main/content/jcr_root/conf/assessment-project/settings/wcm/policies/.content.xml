<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <assessment-project jcr:primaryType="nt:unstructured">
        <components jcr:primaryType="nt:unstructured">

            <page jcr:primaryType="nt:unstructured">
                <policy_page_default
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Assessment Page Policy"
                    sling:resourceType="wcm/core/components/policy/policy"
                    clientlibs="[assessment.site]">
                    <jcr:content jcr:primaryType="nt:unstructured" />
                </policy_page_default>
            </page>

            <core jcr:primaryType="nt:unstructured">
                <wcm jcr:primaryType="nt:unstructured">
                    <components jcr:primaryType="nt:unstructured">
                        <container jcr:primaryType="nt:unstructured">
                            <v1 jcr:primaryType="nt:unstructured">
                                <container jcr:primaryType="nt:unstructured">
                                    <policy_main_container
                                        jcr:primaryType="nt:unstructured"
                                        jcr:title="Assessment Main Container"
                                        sling:resourceType="wcm/core/components/policy/policy"
                                        components="[/apps/assessment/components/weather,group:Core]"
                                        layoutDisabled="false">
                                        <jcr:content jcr:primaryType="nt:unstructured" />
                                    </policy_main_container>
                                </container>
                            </v1>
                        </container>
                    </components>
                </wcm>
            </core>

        </components>
    </assessment-project>
</jcr:root>