/filters {
    /0000 { /type "deny" /url "/*" }
    /0001 { /type "allow" /method "GET" /url "/content/assessment/*.html" }
    /0002 { /type "allow" /method "GET" /url "/content/assessment/*.model.json" }
    /0010 { /type "allow" /url "/etc.clientlibs/*" }
    /0020 { /type "allow" /method "GET" /url "/libs/granite/csrf/token.json" }
    /9999 { /type "deny" /url "/content/assessment/us/en/jcr:content*" }
}